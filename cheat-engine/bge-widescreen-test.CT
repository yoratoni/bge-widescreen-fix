    <CheatEntry>
      <ID>18</ID>
      <Description>"[H] Hor+ for world camera, in matrix builder  +A98009 (needs A2 or A4)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Right after t = tan(FOV/2): if A4 flagged the world camera, t *= 0.5625/ws_ratio
// -> vertical scale identical to 16:9, horizontal widened (Hor+).
alloc(ws_hp,64,"bge.exe"+A98009)
label(ws_hp_orig)
label(ws_hp_ret)
ws_hp:
  cmp byte ptr [ws_flag],1
  jne ws_hp_orig
  mov byte ptr [ws_flag],0
  mulss xmm0,[ws_invk]
ws_hp_orig:
  cmp byte ptr [rsp+80],0
  jmp ws_hp_ret
"bge.exe"+A98009:
  jmp ws_hp
  nop 3
ws_hp_ret:
[DISABLE]
"bge.exe"+A98009:
  db 80 BC 24 80 00 00 00 00
dealloc(ws_hp)
</AssemblerScript>
