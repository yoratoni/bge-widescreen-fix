    <CheatEntry>
      <ID>32</ID>
      <Description>"[T] text origin offset  +A2F7A3"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Text renderer: string origin in pixels is computed into xmm0 (x) / xmm2 (y)
// right before being stored as int16 globals. Add live-tunable offsets.
alloc(ws_txt,64,"bge.exe"+A2F7A3)
alloc(ws_txtoff,16,"bge.exe")
registersymbol(ws_txtoff)
label(ws_txt_ret)
// tuned for 3440x1440: x = (W - 16/9*H)/2 = 440, y = H/2*(1 - (16/9*H)/W) = 184
ws_txtoff:
  dd (float)440
  dd (float)184
ws_txt:
  addss xmm0,[ws_txtoff]
  addss xmm2,[ws_txtoff+4]
  cvttss2si eax,xmm0
  mov [bge.exe+19B0020],ax
  jmp ws_txt_ret
"bge.exe"+A2F7A3:
  jmp ws_txt
  nop 6
ws_txt_ret:
[DISABLE]
"bge.exe"+A2F7A3:
  db F3 0F 2C C0 66 89 05 72 08 F8 00
dealloc(ws_txt)
// ws_txtoff kept so the offset entries stay valid
</AssemblerScript>
