    <CheatEntry>
      <ID>16</ID>
      <Description>"[A3] viewport fit, all views EXCEPT DD camera  +AAB9CC (exclusive with A/A2)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Opposite of A2: override the ratio for every fitted view except DD+0x1D0
// (i.e. only the stack-built cameras). rbx = GDI_gpst_CurDD, r8 = view.
alloc(ws_vp3,64,"bge.exe"+AAB9CC)
label(ws_vp3_orig)
label(ws_vp3_ret)
ws_vp3:
  cmp rdx,3
  jne ws_vp3_orig
  lea rax,[rbx+1D0]
  cmp r8,rax
  je ws_vp3_orig
  movss xmm6,[ws_ratio]
  jmp ws_vp3_ret
ws_vp3_orig:
  movss xmm6,[rcx+rdx*4]
  jmp ws_vp3_ret
"bge.exe"+AAB9CC:
  jmp ws_vp3
ws_vp3_ret:
[DISABLE]
"bge.exe"+AAB9CC:
  db F3 0F 10 34 91
dealloc(ws_vp3)
</AssemblerScript>
