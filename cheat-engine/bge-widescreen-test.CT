    </CheatEntry>
    <CheatEntry>
      <ID>8</ID>
      <Description>"[A] viewport fit  +AAB9CC"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(ws_vp,64,"bge.exe"+AAB9CC)
label(ws_vp_orig)
label(ws_vp_ret)
ws_vp:
  cmp rdx,3
  jne ws_vp_orig
  movss xmm6,[ws_ratio]
  jmp ws_vp_ret
ws_vp_orig:
  movss xmm6,[rcx+rdx*4]
  jmp ws_vp_ret
"bge.exe"+AAB9CC:
  jmp ws_vp
ws_vp_ret:
[DISABLE]
"bge.exe"+AAB9CC:
  db F3 0F 10 34 91
dealloc(ws_vp)
</AssemblerScript>
