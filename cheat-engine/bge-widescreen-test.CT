    <CheatEntry>
      <ID>6</ID>
      <Description>"[0] ws_ratio storage (enable before A/B/C, disable after)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Private values read by the hooks (the shared table at +16E595C stays 0.5625).
// ws_k = ws_ratio / 0.5625, ws_invk = 0.5625 / ws_ratio. Update all three if you change the ratio.
// Memory is intentionally never freed: disabling this while hooks are active used to crash.
alloc(ws_ratio,32,"bge.exe")
registersymbol(ws_ratio)
label(ws_k)
registersymbol(ws_k)
label(ws_invk)
registersymbol(ws_invk)
label(ws_flag)
registersymbol(ws_flag)
ws_ratio:
  dd (float)0.418604
ws_k:
  dd (float)0.744185
ws_invk:
  dd (float)1.34375
ws_flag:
  db 0
[DISABLE]
// nothing: keep the memory alive
</AssemblerScript>
      <Hotkeys>
        <Hotkey>
          <Action>Toggle Activation</Action>
          <Keys>
            <Key>116</Key>
          </Keys>
          <ID>0</ID>
        </Hotkey>
      </Hotkeys>
    </CheatEntry>
