    <CheatEntry>
      <ID>13</ID>
      <Description>"[C+] per-view camera Hor+ scale  +A1D2FA (use with C)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// At the FactorX/FactorY store: if hook C supplied ws_ratio (xmm8), scale both by ws_k.
alloc(ws_camh,64,"bge.exe"+A1D2FA)
label(ws_camh_orig)
label(ws_camh_ret)
ws_camh:
  ucomiss xmm8,[ws_ratio]
  jp ws_camh_orig
  jne ws_camh_orig
  mulss xmm6,[ws_k]
  mulss xmm7,[ws_k]
ws_camh_orig:
  movss [rbx+14],xmm6
  jmp ws_camh_ret
"bge.exe"+A1D2FA:
  jmp ws_camh
ws_camh_ret:
[DISABLE]
"bge.exe"+A1D2FA:
  db F3 0F 11 73 14
dealloc(ws_camh)
</AssemblerScript>
