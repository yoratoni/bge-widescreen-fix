    <CheatEntry>
      <ID>17</ID>
      <Description>"[A4] viewport fit, all views + flag world camera  +AAB9CC (exclusive with A/A2/A3)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Like A (every view gets ws_ratio), and sets ws_flag when the view is the
// world camera (DD+0x1D0) so hook H applies Hor+ to that one projection only.
alloc(ws_vp4,96,"bge.exe"+AAB9CC)
label(ws_vp4_orig)
label(ws_vp4_ret)
ws_vp4:
  mov byte ptr [ws_flag],0
  cmp rdx,3
  jne ws_vp4_orig
  lea rax,[rbx+1D0]
  cmp r8,rax
  jne short @f
  mov byte ptr [ws_flag],1
@@:
  movss xmm6,[ws_ratio]
  jmp ws_vp4_ret
ws_vp4_orig:
  movss xmm6,[rcx+rdx*4]
  jmp ws_vp4_ret
"bge.exe"+AAB9CC:
  jmp ws_vp4
ws_vp4_ret:
[DISABLE]
"bge.exe"+AAB9CC:
  db F3 0F 10 34 91
dealloc(ws_vp4)
</AssemblerScript>
