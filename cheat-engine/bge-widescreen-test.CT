    <CheatEntry>
      <ID>31</ID>
      <Description>"[B2] text projection: B + FactorX*ws_invk  +A2F2D6 (exclusive with B/B+)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Empirical: text width ~ 1/FactorX, text height ~ FactorY/FactorX.
// Want width *0.744, height unchanged -> FactorX *1.344 and FactorY *1.344 (= B).
alloc(ws_proj2,64,"bge.exe"+A2F2D6)
label(ws_proj2_orig)
label(ws_proj2_ret)
ws_proj2:
  cmp rax,3
  jne ws_proj2_orig
  mulss xmm1,[ws_invk]
  mulss xmm2,[ws_ratio]
  jmp ws_proj2_ret
ws_proj2_orig:
  mulss xmm2,[rcx+rax*4]
  jmp ws_proj2_ret
"bge.exe"+A2F2D6:
  jmp ws_proj2
ws_proj2_ret:
[DISABLE]
"bge.exe"+A2F2D6:
  db F3 0F 59 14 81
dealloc(ws_proj2)
</AssemblerScript>
