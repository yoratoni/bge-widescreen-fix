    <CheatEntry>
      <ID>12</ID>
      <Description>"[B+] main projection Hor+  +A2F2D6 (exclusive with B)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Keeps the stock 16:9 vertical factor, scales only FactorX (xmm1) by ws_k.
alloc(ws_projh,64,"bge.exe"+A2F2D6)
label(ws_projh_orig)
label(ws_projh_ret)
ws_projh:
  cmp rax,3
  jne ws_projh_orig
  mulss xmm1,[ws_k]
ws_projh_orig:
  mulss xmm2,[rcx+rax*4]
  jmp ws_projh_ret
"bge.exe"+A2F2D6:
  jmp ws_projh
ws_projh_ret:
[DISABLE]
"bge.exe"+A2F2D6:
  db F3 0F 59 14 81
dealloc(ws_projh)
</AssemblerScript>
