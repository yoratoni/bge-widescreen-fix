    <CheatEntry>
      <ID>19</ID>
      <Description>"[LOG] viewport offsets per view  +AABB2C"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Logs the fitted viewport offset of each view passing through the fit function.
// Slot 0 = world camera (DD+0x1D0), slot 1/2 = the two stack cameras (split on bit 4 of r8).
// Each slot: +0 x offset, +4 y offset, +8 fitted height (ints).
alloc(ws_log,128,"bge.exe"+AABB2C)
alloc(ws_logdata,64,"bge.exe")
registersymbol(ws_logdata)
label(ws_log_slot)
label(ws_log_ret)
ws_log:
  mov [r8+40],eax
  lea rax,[ws_logdata]
  push rcx
  lea rcx,[rbx+1D0]
  cmp r8,rcx
  je short ws_log_slot
  add rax,10
  test r8,10
  je short ws_log_slot
  add rax,10
ws_log_slot:
  mov ecx,[r8+3C]
  mov [rax],ecx
  mov ecx,[r8+40]
  mov [rax+4],ecx
  mov [rax+8],r10d
  pop rcx
  mov rax,[bge.exe+209FD90]
  jmp ws_log_ret
"bge.exe"+AABB2C:
  jmp ws_log
  nop 6
ws_log_ret:
[DISABLE]
"bge.exe"+AABB2C:
  db 41 89 40 40 48 8B 05 59 42 5F 01
dealloc(ws_log)
// ws_logdata intentionally kept so the value entries stay readable
</AssemblerScript>
    </CheatEntry>
