    <CheatEntry>
      <ID>11</ID>
      <Description>"[A2] viewport fit, world camera only (+ flags it for H)  +AAB9CC (exclusive with A/A3/A4)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// Same site as A, but only overrides the ratio when the view being fitted
// is the main display camera (DD+0x1D0). rbx = GDI_gpst_CurDD, r8 = view.
alloc(ws_vp2,64,"bge.exe"+AAB9CC)
label(ws_vp2_orig)
label(ws_vp2_ret)
ws_vp2:
  mov byte ptr [ws_flag],0
  cmp rdx,3
  jne ws_vp2_orig
  lea rax,[rbx+1D0]
  cmp r8,rax
  jne ws_vp2_orig
  mov byte ptr [ws_flag],1
  movss xmm6,[ws_ratio]
  jmp ws_vp2_ret
ws_vp2_orig:
  movss xmm6,[rcx+rdx*4]
  jmp ws_vp2_ret
"bge.exe"+AAB9CC:
  jmp ws_vp2
ws_vp2_ret:
[DISABLE]
"bge.exe"+AAB9CC:
  db F3 0F 10 34 91
dealloc(ws_vp2)
</AssemblerScript>
